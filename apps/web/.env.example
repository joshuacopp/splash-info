# apps/web environment variables.
#
# Copy to .env.local for local development. Set in Cloudflare Pages /
# wrangler vars for production.
#
# All NEXT_PUBLIC_* vars are inlined into the client bundle at build time.
# Do not put secrets here.

# =============================================================================
# Worker base URLs
# =============================================================================
#
# Each value is the absolute base URL of the corresponding Cloudflare Worker.
# apps/web prepends this base when calling the worker's JSON endpoints.
#
# Behavior by value:
#   <empty / unset>                          → relative URL (same-origin,
#                                              what production uses post-cutover
#                                              when apps/web and the worker both
#                                              live on splashcarwashes.info)
#   https://<name>.<account>.workers.dev     → cross-origin (dev / staging only;
#                                              cookies will NOT persist across
#                                              origins under SameSite=Lax — log-in
#                                              testing is functional but the
#                                              session won't survive a page reload
#                                              from apps/web on a different origin)
#   https://splashcarwashes.info             → explicit absolute, equivalent to
#                                              the empty/unset case post-cutover
#
# For local dev, point each var at the live workers.dev URL so the form posts
# go somewhere real. Production should clear these so apps/web uses relative
# URLs (same-origin).

NEXT_PUBLIC_DASHBOARD_WORKER_URL=https://splash-dashboard.joshua-copp.workers.dev
NEXT_PUBLIC_SIGNUP_WORKER_URL=https://splash-signup-next.joshua-copp.workers.dev
NEXT_PUBLIC_PERFORMANCE_WORKER_URL=https://splash-performance.joshua-copp.workers.dev
NEXT_PUBLIC_SYSADMIN_WORKER_URL=https://splash-sysadmin.joshua-copp.workers.dev
NEXT_PUBLIC_DAMAGE_WORKER_URL=https://splash-damage.joshua-copp.workers.dev

# =============================================================================
# Server actions encryption key (Brief 31)
# =============================================================================
#
# Stable encryption key for Next.js server actions. Set this to a
# 32-byte base64 string and DO NOT change it across deploys (changing
# it invalidates all action IDs on every open browser tab and
# produces UnrecognizedActionError white-pages mid-session).
#
# Why: Next 15 derives server-action IDs from a hash of the action body
# combined with this key. When unset, Next generates a fresh random key
# on every `next build`, so every redeploy invalidates every action ID
# in every open tab. Operators hitting submit on a tab opened before
# the redeploy get a client-side exception white-page (root cause of
# the 2026-05-05 grant-tool incident).
#
# Generate ONCE and store securely (e.g., password manager). Do not
# rotate without coordination — rotation invalidates every action ID on
# every open tab.
#
# Generate via:
#   PowerShell:
#     $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
#   Bash:
#     openssl rand -base64 32
#
# Set as a CF Workers Builds BUILD-TIME env var (NOT a runtime secret)
# on apps/web's worker. Build-time only because Next reads this during
# `next build`; the runtime never needs it again.
#   - Build-time env: CF dashboard → Workers & Pages → splash-web →
#     Settings → Build → Environment variables. Baked into the build
#     artifact.
#   - Runtime secret (`wrangler secret put`): WRONG for this var. Has
#     no effect because Next's bundle is already built.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
